{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "cleaning-weekly",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"BOOKING_BROOM_SITE_SLUG": "cleaning-weekly"
	}
	// BOOKING_BROOM_API_KEY is a secret, not a var. Set it with
	// `wrangler secret put BOOKING_BROOM_API_KEY` for the deployed worker, and
	// put it in .dev.vars (gitignored) for local development.
}