# SMTP (Nodemailer) — fill in when your email provider is ready
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cleaning Weekly <noreply@cleaningweekly.com>"
ADMIN_EMAIL=

# Booking Broom — forwards bookings to the manager dashboard
# BOOKING_BROOM_URL optional; defaults to https://app.bookingbroom.com
# Optional local override (defaults to https://app.bookingbroom.com)
# BOOKING_BROOM_URL=http://localhost:3000
BOOKING_BROOM_API_KEY=
# Optional override (defaults to cleaning-weekly)
# BOOKING_BROOM_SITE_SLUG hardcoded to cleaning-weekly in code — do not set