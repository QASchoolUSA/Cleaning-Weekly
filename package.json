{
  "name": "cleaning-weekly",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && cp dist/client/sitemap-0.xml dist/client/sitemap.xml && rm -f dist/client/sitemap-index.xml dist/client/sitemap-0.xml",
    "preview": "pnpm run build && wrangler dev",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.2",
    "@astrojs/node": "^11.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.7",
    "nodemailer": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "wrangler": "^4.110.0"
  }
}
