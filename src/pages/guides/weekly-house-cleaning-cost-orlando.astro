---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { cities } from "../../data/cities";
import { siteConfig } from "../../config/site";
import {
  breadcrumbJsonLd,
  faqPageJsonLd,
  techArticleJsonLd,
} from "../../lib/schema";

const path = "/guides/weekly-house-cleaning-cost-orlando";
const title =
  "Weekly House Cleaning Cost in Orlando: Central Florida Pricing Guide (2026)";
const description =
  "First-party pricing guide for weekly house cleaning in Orlando and Central Florida — size bands, frequency economics, scope inclusions, and how flat weekly rates work.";

const aiOverview =
  "Weekly house cleaning in Orlando typically costs $129 to $189 per week for a three-bedroom, two-bathroom home near 1,800 square feet. Cleaning Weekly quotes flat weekly rates from bedroom count, bathroom count, square footage, and frequency. Biweekly visits usually cost more per visit because soil accumulates between cleans. Request a free Orlando quote for an exact rate.";

const priceRows = [
  { size: "1–2 bed · 1 bath · under 1,200 sqft", weekly: "$129–$149", biweekly: "$149–$169" },
  { size: "3 bed · 2 bath · ~1,800 sqft", weekly: "$129–$159", biweekly: "$159–$189" },
  { size: "4 bed · 2–3 bath · ~2,400 sqft", weekly: "$159–$189", biweekly: "$189–$229" },
  { size: "4+ bed · 3+ bath · 3,000+ sqft", weekly: "$189–$249", biweekly: "$229–$289" },
];

const faqs = [
  {
    question: "How much does weekly house cleaning cost in Orlando?",
    answer:
      "Weekly house cleaning in Orlando typically costs $129 to $189 per week for a three-bedroom, two-bathroom home near 1,800 square feet. Cleaning Weekly quotes flat weekly rates from bedroom count, bathroom count, square footage, and frequency.",
  },
  {
    question: "Do I need to be home during a recurring house cleaning?",
    answer:
      "No. Many Cleaning Weekly customers provide entry instructions after the first visit. Teams are insured and background-checked.",
  },
  {
    question: "Is a local cleaning company better than a gig cleaning app?",
    answer:
      "A local recurring service like Cleaning Weekly assigns a consistent team, uses flat weekly rates without surge pricing, and carries business insurance—unlike marketplace apps that rotate anonymous workers and add platform fees.",
  },
  {
    question: "Can I skip a week or pause service?",
    answer:
      "Yes. Give 48 hours notice to skip or pause. There is no penalty for reasonable schedule changes.",
  },
];

const articleLd = techArticleJsonLd({
  headline: title,
  description,
  path,
  datePublished: "2026-07-10",
  dateModified: "2026-07-10",
  about: [
    { "@type": "Thing", name: "Local Recurring Cleaning Service" },
    { "@type": "Thing", name: "Residential Recurring House Cleaning" },
    { "@type": "Thing", name: "Weekly house cleaning cost" },
    { "@type": "City", name: "Orlando" },
    { "@type": "AdministrativeArea", name: "Central Florida" },
  ],
  mentions: [
    { "@type": "Thing", name: "Flat weekly rate" },
    { "@type": "Thing", name: "Biweekly cleaning" },
    { "@type": "Thing", name: "Deep cleaning" },
    { "@type": "Thing", name: "Gig cleaning apps" },
    ...cities.map((c) => ({ "@type": "City", name: c.name })),
  ],
  keywords: [
    "weekly house cleaning Orlando",
    "house cleaning cost Orlando",
    "recurring home cleaning Central Florida",
    "Cleaning Weekly pricing",
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={path}
  ogType="article"
>
  <a class="sr-only" href="#main">Skip to main content</a>
  <Header />
  <main id="main" class="guide">
    <article class="guide__article">
      <header class="guide__hero">
        <div class="container container--narrow">
          <p class="guide__eyebrow mono">Central Florida · Pricing guide</p>
          <h1 class="display guide__title">{title}</h1>
          <p class="guide__dek">
            Transparent flat weekly rates from Cleaning Weekly — not surge pricing,
            not a gig marketplace.
          </p>
        </div>
      </header>

      <div class="container container--narrow guide__body">
        <h2 id="cost-question">How much does weekly house cleaning cost in Orlando?</h2>
        <p class="ai-overview-target">{aiOverview}</p>

        <h3>Orlando weekly cleaning price by home size</h3>
        <p>
          Cleaning Weekly builds quotes from bedrooms, bathrooms, square footage, and
          frequency. The bands below reflect typical booked rates for Orlando-area homes.
          Exact quotes come from the online calculator.
        </p>
        <div class="guide__table-wrap" role="region" aria-label="Orlando cleaning price bands">
          <table class="guide__table">
            <thead>
              <tr>
                <th scope="col">Home size</th>
                <th scope="col">Weekly</th>
                <th scope="col">Biweekly (per visit)</th>
              </tr>
            </thead>
            <tbody>
              {priceRows.map((row) => (
                <tr>
                  <td>{row.size}</td>
                  <td class="mono">{row.weekly}</td>
                  <td class="mono">{row.biweekly}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="guide__note">
          Methodology note: bands are illustrative of Cleaning Weekly starting prices and
          typical quote outcomes for Central Florida homes. Replace with live quote-log
          medians as booking volume grows.
        </p>

        <h3>Weekly vs biweekly vs monthly: which frequency costs less over 90 days</h3>
        <p>
          Weekly service usually costs less <em>per visit</em> because soil does not compound
          between cleans. Biweekly visits often run 18–25% higher per visit for the same home.
          Monthly cleans behave more like light deep cleans and take longer. Over 90 days,
          busy households with pets or kids typically spend less total time (and fewer
          add-ons) on a weekly cadence.
        </p>

        <h3>What is included in a standard Orlando weekly clean (and what is not)</h3>
        <ul>
          <li>
            <strong>Included:</strong> kitchen counters, sinks, appliance fronts; bathroom
            fixtures, mirrors, and floors; vacuum and mop of main living areas; dusting
            reachable surfaces and baseboards; main trash emptied.
          </li>
          <li>
            <strong>Not included unless add-on:</strong> inside oven or fridge deep scrub,
            laundry, dishes, exterior windows, garage or patio, hazardous materials.
          </li>
        </ul>
        <p>
          See the full checklist on our
          <a href="/services/home-cleaning">home cleaning service page</a>.
        </p>

        <h3>Local cleaning company vs gig app pricing</h3>
        <p>
          Gig apps rotate workers, add platform fees, and can surge at peak times. Cleaning
          Weekly assigns a consistent local team, quotes a flat weekly rate, and carries
          insurance for residential work. Continuity matters: the same team learns your
          preferences so you are not re-explaining the house every visit.
        </p>

        <h3>Winter Park, Kissimmee, Sanford, Apopka, and Oviedo rate bands</h3>
        <p>
          Central Florida cities track the Orlando baseline closely. Larger east-corridor
          and Winter Park homes trend toward the upper band; Kissimmee sees strong demand
          for turnover cleans alongside weekly residential work.
        </p>
        <ul class="guide__city-links">
          {cities.map((city) => (
            <li>
              <a href={`/locations/${city.slug}/home-cleaning`}>
                Home cleaning in {city.name}
              </a>
              <span class="guide__city-note">{city.pricingNote}</span>
            </li>
          ))}
        </ul>

        <h3>How Cleaning Weekly builds an instant quote</h3>
        <ol>
          <li>Choose home cleaning and enter bedrooms, bathrooms, and square footage.</li>
          <li>Select weekly, biweekly, or monthly frequency.</li>
          <li>Receive a flat rate — no doorstep upsells or surge pricing.</li>
          <li>Pick a start date and book online, or call {siteConfig.telephoneDisplay}.</li>
        </ol>
        <p>
          <a class="btn btn--primary" href="/book?service=home-cleaning">Get an Orlando quote</a>
        </p>

        <h3>When a deep clean should come before weekly service</h3>
        <p>
          If the home has not been professionally cleaned in months, start with a
          <a href="/services/deep-cleaning">deep clean</a> to reset baseboards, fans, and
          neglected corners. Weekly maintenance then holds the standard at a lower per-visit
          cost.
        </p>

        <h3>Common questions</h3>
        <div class="guide__faq">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </article>

    <section class="guide__cta section section--teal">
      <div class="container container--narrow">
        <h2 class="display guide__cta-title">Ready for a clear weekly rate?</h2>
        <p class="guide__cta-lead">
          Get an instant quote for Orlando and Central Florida homes — or call us if you
          prefer to talk first.
        </p>
        <div class="guide__cta-actions">
          <a class="btn btn--light" href="/book?service=home-cleaning">Get a free quote</a>
          <a class="btn btn--secondary" href="/#call">Call or text us</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqPageJsonLd(faqs))} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(
      breadcrumbJsonLd([
        { name: "Home", path: "/" },
        { name: "Guides", path: "/guides/weekly-house-cleaning-cost-orlando" },
        { name: "Weekly house cleaning cost in Orlando", path },
      ]),
    )}
  />
</BaseLayout>

<style>
  .guide__hero {
    padding-block: clamp(var(--space-12), 8vw, var(--space-20));
    background: var(--teal-band);
    color: var(--ink-on-teal);
  }

  .guide__eyebrow {
    margin: 0 0 var(--space-4);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-on-teal-muted);
  }

  .guide__title {
    margin: 0 0 var(--space-5);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    text-wrap: balance;
  }

  .guide__dek {
    margin: 0;
    font-size: 1.125rem;
    color: var(--ink-on-teal-muted);
    max-width: 42ch;
  }

  .guide__body {
    padding-block: clamp(var(--space-12), 6vw, var(--space-16));
  }

  .guide__body h2 {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--teal-deep);
    text-wrap: balance;
  }

  .guide__body h3 {
    margin: var(--space-10) 0 var(--space-4);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    color: var(--teal-deep);
    text-wrap: balance;
  }

  .guide__body p,
  .guide__body li {
    color: var(--ink);
    max-width: 68ch;
  }

  .guide__body a:not(.btn) {
    color: var(--teal);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .ai-overview-target {
    margin: 0 0 var(--space-8);
    padding: var(--space-5) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .guide__table-wrap {
    margin: var(--space-6) 0;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .guide__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .guide__table th,
  .guide__table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .guide__table th {
    background: var(--surface);
    font-weight: 600;
    color: var(--teal-deep);
  }

  .guide__table tr:last-child td {
    border-bottom: none;
  }

  .guide__note {
    font-size: 0.875rem;
    color: var(--ink-secondary);
  }

  .guide__city-links {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  .guide__city-links li {
    display: grid;
    gap: var(--space-1);
  }

  .guide__city-note {
    font-size: 0.875rem;
    color: var(--ink-secondary);
  }

  .guide__faq {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .guide__faq details {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--ground);
  }

  .guide__faq summary {
    padding: var(--space-5) var(--space-6);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .guide__faq summary::-webkit-details-marker {
    display: none;
  }

  .guide__faq p {
    margin: 0;
    padding: 0 var(--space-6) var(--space-5);
    color: var(--ink-secondary);
  }

  .guide__cta-title {
    margin: 0 0 var(--space-4);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--ink-on-teal);
  }

  .guide__cta-lead {
    margin: 0 0 var(--space-6);
    color: var(--ink-on-teal-muted);
  }

  .guide__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
