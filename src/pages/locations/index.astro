---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { cities } from "../../data/cities";
import { breadcrumbJsonLd } from "../../lib/schema";

const path = "/locations";
const title = "Service Areas — Central Florida Cleaning | Cleaning Weekly";
const description =
  "Cleaning Weekly serves Orlando, Winter Park, Kissimmee, Sanford, Apopka, Oviedo, and surrounding Central Florida communities with recurring home and office cleaning.";
const faqs = [
  { question: "Which Central Florida cities does Cleaning Weekly serve?", answer: "Cleaning Weekly serves Orlando, Winter Park, Kissimmee, Sanford, Apopka, Oviedo, and nearby communities. Exact availability depends on the address and schedule, so include your ZIP code when requesting a quote." },
  { question: "Does pricing change by city?", answer: "Quotes are driven mainly by service, size, bathrooms, condition, frequency, and add-ons. An address outside the normal route may require confirmation before a date is accepted." },
  { question: "Can I book recurring cleaning for an apartment or office?", answer: "Yes. The service area includes houses, apartments, condos, and small offices when access, parking, and scheduling requirements are provided in advance." },
];
---

<BaseLayout title={title} description={description} canonicalPath={path}>
  <a class="sr-only" href="#main">Skip to main content</a>
  <Header />
  <main id="main">
    <section class="areas-hero">
      <div class="container container--narrow">
        <p class="areas-hero__eyebrow mono">Central Florida</p>
        <h1 class="display areas-hero__title">Where we clean</h1>
        <p class="areas-hero__lead">
          Recurring home and office cleaning across Central Florida cities — same
          trusted local teams, flat weekly rates.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <ul class="areas-grid">
          {cities.map((city) => (
            <li>
              <a href={`/locations/${city.slug}`} class="areas-card">
                <span class="headline areas-card__name">{city.name}</span>
                <span class="areas-card__meta">
                  {city.neighborhoods.slice(0, 3).join(" · ")}
                </span>
                <span class="areas-card__cta mono">View services →</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="areas-guide">
          Pricing questions?
          <a href="/guides/weekly-house-cleaning-cost-orlando">
            Weekly house cleaning cost in Orlando
          </a>
        </p>
      </div>
    </section>
    <section class="section section--surface">
      <div class="container container--narrow">
        <h2 class="headline areas-content__title">Local cleaning built around Central Florida homes</h2>
        <p>Central Florida homes contend with year-round air-conditioning, summer rain, pollen, hard-floor traffic, and busy schedules shaped by schools, commuting, hospitality, and tourism. A useful cleaning plan accounts for the property itself—house, apartment, condo, office, or short-term rental—not just the city printed in the address.</p>
        <p>Before the first visit, share gate or building access, parking, pets, stairs, floor materials, and the rooms that matter most. Weekly service is often the right fit for active households and offices; biweekly service can maintain a recent deep clean for lighter-use homes. One-time deep and move-related cleans are also available throughout the route.</p>
        <h2 class="headline areas-content__title">Service-area questions</h2>
        <div class="areas-faq">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(
      breadcrumbJsonLd([
        { name: "Home", path: "/" },
        { name: "Locations", path },
      ]),
    )}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    })}
  />
</BaseLayout>

<style>
  .areas-hero {
    padding-block: clamp(var(--space-12), 8vw, var(--space-20));
    background: var(--teal-band);
    color: var(--ink-on-teal);
  }

  .areas-hero__eyebrow {
    margin: 0 0 var(--space-4);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-on-teal-muted);
  }

  .areas-hero__title {
    margin: 0 0 var(--space-5);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
  }

  .areas-hero__lead {
    margin: 0;
    color: var(--ink-on-teal-muted);
    font-size: 1.125rem;
    max-width: 42ch;
  }

  .areas-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  .areas-card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration) var(--ease-out);
  }

  .areas-card:hover {
    border-color: var(--teal-soft);
  }

  .areas-card__name {
    font-size: 1.375rem;
    color: var(--teal-deep);
  }

  .areas-card__meta {
    font-size: 0.9375rem;
    color: var(--ink-secondary);
  }

  .areas-card__cta {
    margin-top: var(--space-2);
    font-size: 0.8125rem;
    color: var(--teal);
  }

  .areas-guide {
    margin-top: var(--space-10);
  }

  .areas-guide a {
    color: var(--teal);
  }

  .areas-content__title {
    margin-top: var(--space-10);
    color: var(--teal-deep);
  }

  .areas-faq {
    display: grid;
    gap: var(--space-3);
  }

  .areas-faq details {
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--ground);
  }

  .areas-faq summary {
    font-weight: 600;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .areas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .areas-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
