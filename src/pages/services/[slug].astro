---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ServicePageContent from "../../components/ServicePageContent.astro";
import { services } from "../../data/services";
import { breadcrumbJsonLd, servicePageJsonLd } from "../../lib/schema";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const path = `/services/${service.slug}`;
---

<BaseLayout
  title={`${service.title} — Cleaning Weekly | Central Florida`}
  description={service.metaDescription}
  canonicalPath={path}
>
  <a class="sr-only" href="#main">Skip to main content</a>
  <Header />
  <main id="main">
    <ServicePageContent service={service} />
  </main>
  <Footer />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(servicePageJsonLd(service))}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(
      breadcrumbJsonLd([
        { name: "Home", path: "/" },
        { name: "Services", path: "/#services" },
        { name: service.title, path },
      ]),
    )}
  />
</BaseLayout>
