---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { formatPrice } from "../../lib/pricing";

const bookingId = Astro.url.searchParams.get("id") ?? "";
const price = Number(Astro.url.searchParams.get("price") ?? 0);
const unit = (Astro.url.searchParams.get("unit") ?? "week") as "week" | "visit" | "project";
const hasBooking = Boolean(bookingId && price > 0);
const priceLabel = hasBooking ? formatPrice(price, unit) : "";
---

<BaseLayout title="Booking Confirmed | Cleaning Weekly">
  <Header />
  <main id="main" class="confirmation section">
    <div class="container container--narrow confirmation__inner">
      {hasBooking ? (
        <>
          <h1 class="display confirmation__title">You are booked!</h1>
          <p class="confirmation__lead">
            A confirmation email is on its way with your booking details. We will
            confirm your exact arrival window within one business day.
          </p>
          <dl class="confirmation__details">
            <div>
              <dt>Booking ID</dt>
              <dd class="mono">{bookingId}</dd>
            </div>
            <div>
              <dt>Estimated rate</dt>
              <dd class="mono">{priceLabel}</dd>
            </div>
          </dl>
          <p class="confirmation__next mono">
            What happens next: confirmation email → schedule lock-in → same team weekly
          </p>
          <a class="btn btn--primary" href="/">Back to home</a>
        </>
      ) : (
        <>
          <h1 class="display confirmation__title">Booking not found</h1>
          <p class="confirmation__lead">
            We could not find a booking reference. If you just completed a booking,
            check your email for confirmation.
          </p>
          <a class="btn btn--primary" href="/book">Start a new booking</a>
        </>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .confirmation__inner {
    padding-block: clamp(var(--space-16), 8vw, var(--space-24));
  }

  .confirmation__title {
    margin: 0 0 var(--space-4);
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--teal-deep);
  }

  .confirmation__lead {
    margin: 0 0 var(--space-8);
    color: var(--ink-secondary);
    font-size: 1.0625rem;
  }

  .confirmation__details {
    margin: 0 0 var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    display: grid;
    gap: var(--space-4);
  }

  .confirmation__details dt {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-secondary);
  }

  .confirmation__details dd {
    margin: var(--space-1) 0 0;
    font-size: 1.125rem;
    color: var(--teal-deep);
  }

  .confirmation__next {
    margin: 0 0 var(--space-8);
    font-size: 0.875rem;
    color: var(--ink);
  }
</style>
