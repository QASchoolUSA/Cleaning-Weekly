---
import { services } from "../data/services";
import { cities } from "../data/cities";
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name">Cleaning Weekly</p>
      <p class="site-footer__tagline">
        Affordable, local recurring cleaning across Central Florida.
      </p>
    </div>

    <div class="site-footer__links">
      <p class="site-footer__heading">Services</p>
      <ul class="site-footer__list">
        {services.map((service) => (
          <li><a href={`/services/${service.slug}`}>{service.title}</a></li>
        ))}
      </ul>
    </div>

    <div class="site-footer__links">
      <p class="site-footer__heading">Locations</p>
      <ul class="site-footer__list">
        {cities.map((city) => (
          <li><a href={`/locations/${city.slug}`}>{city.name}</a></li>
        ))}
      </ul>
    </div>

    <div class="site-footer__meta">
      <p class="mono site-footer__area">Service area: All Central Florida cities</p>
      <nav class="site-footer__nav" aria-label="Footer">
        <a href="/book">Book now</a>
        <a href="/#call">Call us</a>
        <a href="/#faq">FAQ</a>
        <a href="/guides/weekly-house-cleaning-cost-orlando">Pricing guide</a>
        <a href="/locations">All locations</a>
      </nav>
    </div>

    <p class="site-footer__legal">
      © {new Date().getFullYear()} Cleaning Weekly. Insured · Background-checked teams.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(var(--space-12), 6vw, var(--space-16));
    background: var(--teal-deep);
    color: var(--ink-on-teal-muted);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-8);
  }

  .site-footer__name {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--ink-on-teal);
  }

  .site-footer__tagline {
    margin: 0;
    max-width: 28ch;
  }

  .site-footer__heading {
    margin: 0 0 var(--space-3);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-on-teal);
  }

  .site-footer__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .site-footer__list a {
    color: var(--ink-on-teal-muted);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .site-footer__list a:hover {
    color: var(--ink-on-teal);
    text-decoration: underline;
  }

  .site-footer__area {
    margin: 0 0 var(--space-4);
    font-size: 0.875rem;
    color: var(--ink-on-teal);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
  }

  .site-footer__nav a {
    color: var(--ink-on-teal);
    font-weight: 500;
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    text-decoration: underline;
  }

  .site-footer__legal {
    margin: 0;
    padding-top: var(--space-6);
    border-top: 1px solid oklch(100% 0 0 / 0.12);
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1.2fr 1fr 1fr 1fr;
      align-items: start;
    }

    .site-footer__legal {
      grid-column: 1 / -1;
    }
  }
</style>
